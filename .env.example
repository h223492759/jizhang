# ============================================
#  复制本文件为 .env 后按需修改
#  cp .env.example .env
# ============================================

# JWT 签名密钥【务必修改】，随便一串足够长的随机字符
# 生成方法（NAS 终端）：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# 首次启动自动创建的管理员账号（数据库已存在则不会重复创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# 是否允许在登录页自助注册。
# 默认 false —— 登录页不显示注册入口，账号由管理员登录后在「用户管理」页创建。
# 确实想开放自助注册再改成 true。
ALLOW_REGISTER=false

# ---------- AI 能力（全部可留空）----------
# 留空 => 一句话记账走内置规则解析，月度分析走本地统计，功能照常可用
#
# OpenAI 官方：   https://api.openai.com/v1
# DeepSeek：      https://api.deepseek.com/v1
# 本地 Ollama：   http://192.168.x.x:11434/v1   （AI_API_KEY 可留空）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
